{
  "name": "rinkscreens",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "publish-release": "powershell -ExecutionPolicy Bypass -File scripts/publish-release.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "ical-expander": "^3.2.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-ical": "^0.26.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^8.2.2",
    "supertest": "^7.2.2",
    "terser": "^5.48.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "core-js@3.49.0": true
  }
}
